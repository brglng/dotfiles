{
  "$schema": "https://raw.githubusercontent.com/wynainfo/pi-permission-modes/main/schemas/permission-mode.schema.json",
  "defaultMode": "default",
  "cycleOrder": [ "default" ],
  "modes": {
    "default": {
      "label": "Default",
      "color": "accent",
      "injectSandboxInfo": true,
      "sandbox": {
        "enabled": true,
        "writable": true,
        "askOnBlockedHost": true,
        "allowWrite": [
          "/tmp",
          "~/github/brglng/work-sync",
          "~/github/brglng/dotfiles",
          "~/.pi/agent/extensions",
          "~/.pi/agent/npm",
          "~/Library/Caches/Homebrew",
          "~/Library/Logs/Homebrew",
          "/usr/local/Homebrew",
          "/usr/local/Cellar",
          "/usr/local/var/homebrew",
          "/usr/local/opt",
          "/usr/local/Library/Taps",
          "/usr/local/Library/Caches",
          "/usr/local/var/cache",
          "/opt/homebrew",
          "/opt/homebrew/Cellar",
          "/opt/homebrew/var/homebrew",
          "/opt/homebrew/opt",
          "/opt/homebrew/Library/Taps",
          "/opt/homebrew/Library/Caches",
          "/opt/homebrew/var/cache"
        ],
        "denyRead": [
          "~/.ssh",
          "~/.aws",
          "~/.gnupg",
          "~/.kube",
          "~/.config/gcloud",
          "~/.config/gh/hosts.yml",
          "~/.docker/config.json",
          "~/.npmrc",
          "~/.pypirc",
          "~/.netrc",
          "~/.git-credentials",
          "~/.pi/agent/auth.json",
          "~/.pi/agent/mcp-oauth",
          "**/.env",
          "**/.env.*",
          "**/*password*",
          "**/*passwd*",
          "**/*credential*",
          "**/*credentials*",
          "**/*secret*",
          "**/*token*",
          "**/*api_key*",
          "**/*apikey*",
          "**/*.pem",
          "**/*.key",
          "**/*.p12",
          "**/*.pfx",
          "**/*.jks",
          "**/*.keystore",
          "**/id_rsa*",
          "**/id_dsa*",
          "**/id_ecdsa*",
          "**/id_ed25519*",
          "**/secrets",
          "**/secrets/**",
          "**/.secrets",
          "**/.secrets/**"
        ],
        "denyWrite": [
          "~/.ssh",
          "~/.aws",
          "~/.gnupg",
          "~/.kube",
          "~/.config/gcloud",
          "~/.config/gh/hosts.yml",
          "~/.docker/config.json",
          "~/.npmrc",
          "~/.pypirc",
          "~/.netrc",
          "~/.git-credentials",
          "~/.pi/agent/auth.json",
          "~/.pi/agent/mcp-oauth",
          "~/.pi/agent/permission-mode",
          "**/.env",
          "**/.env.*",
          "**/*password*",
          "**/*passwd*",
          "**/*credential*",
          "**/*credentials*",
          "**/*secret*",
          "**/*token*",
          "**/*api_key*",
          "**/*apikey*",
          "**/*.pem",
          "**/*.key",
          "**/*.p12",
          "**/*.pfx",
          "**/*.jks",
          "**/*.keystore",
          "**/id_rsa*",
          "**/id_dsa*",
          "**/id_ecdsa*",
          "**/id_ed25519*",
          "**/secrets",
          "**/secrets/**",
          "**/.secrets",
          "**/.secrets/**",
          "~/github/brglng/dotfiles",
          "~/github/brglng/pi-packages"
        ],
        "network": {
          "allowedDomains": [],
          "deniedDomains": []
        }
      },
      "permission": {
        "path": {
          "*": "ask",
          "*.env": "deny",
          "*.env.*": "deny",
          "*password*": "deny",
          "*passwd*": "deny",
          "*credential*": "deny",
          "*credentials*": "deny",
          "*secret*": "deny",
          "*token*": "deny",
          "*api_key*": "deny",
          "*apikey*": "deny",
          "*.pem": "deny",
          "*.key": "deny",
          "*.p12": "deny",
          "*.pfx": "deny",
          "*.jks": "deny",
          "*.keystore": "deny",
          "*/id_rsa*": "deny",
          "*/id_dsa*": "deny",
          "*/id_ecdsa*": "deny",
          "*/id_ed25519*": "deny",
          "*/.ssh": "deny",
          "*/.ssh/*": "deny",
          "*/.aws": "deny",
          "*/.aws/*": "deny",
          "*/.gnupg": "deny",
          "*/.gnupg/*": "deny",
          "*/.kube": "deny",
          "*/.kube/*": "deny",
          "*/.npmrc": "deny",
          "*/.pypirc": "deny",
          "*/.netrc": "deny",
          "*/.git-credentials": "deny",
          "*/auth.json": "deny",
          "*/mcp-oauth": "deny",
          "*/mcp-oauth/*": "deny",
          "*/secrets": "deny",
          "*/secrets/*": "deny",
          "*/.secrets": "deny",
          "*/.secrets/*": "deny"
        },
        "external_directory": {
          "*": "ask",
          "~/github/brglng/work-sync*": "allow",
          "~/.pi/agent/extensions*": "allow",
          "~/.pi/agent/npm*": "allow",
          "~/github/brglng/dotfiles*": "allow",
          "~/github/brglng/pi-packages*": "allow",
          "/usr/local/Homebrew*": "allow",
          "/usr/local/Cellar*": "allow",
          "/usr/local/var/homebrew*": "allow",
          "/usr/local/opt*": "allow",
          "/opt/homebrew*": "allow"
        },
        "read": "allow",
        "grep": "allow",
        "find": "allow",
        "ls": "allow",
        "write": "ask",
        "edit": "ask",
        "web_search": "allow",
        "tool": {
          "*": "ask",
          "ask_user_question": "allow",
          "ast_grep_dump": "allow",
          "ast_grep_outline": "allow",
          "ast_grep_search": "allow",
          "bg_delegate": "allow",
          "bg_kill": "allow",
          "bg_logs": "allow",
          "bg_result": "allow",
          "bg_run": "allow",
          "bg_run_pi_attested": "allow",
          "bg_status": "allow",
          "contact_supervisor": "allow",
          "ctx_doctor": "allow",
          "ctx_execute": "allow",
          "ctx_execute_file": "allow",
          "ctx_search": "allow",
          "ctx_stats": "allow",
          "fetch": "allow",
          "fetch_content": "allow",
          "fffind": "allow",
          "ffgrep": "allow",
          "find": "allow",
          "fusion_investigate": "allow",
          "fusion_reason": "allow",
          "fusion_research": "allow",
          "fusion_validate": "allow",
          "get_search_content": "allow",
          "grep": "allow",
          "lens_diagnostics": "allow",
          "ls": "allow",
          "lsp_diagnostics": "allow",
          "lsp_navigation": "allow",
          "memory_add": "allow",
          "memory_replace": "allow",
          "memory_search": "allow",
          "module_report": "allow",
          "notify_user": "allow",
          "project_report": "allow",
          "read": "allow",
          "read_enclosing": "allow",
          "read_symbol": "allow",
          "search": "allow",
          "session_query": "allow",
          "session_search": "allow",
          "skill_manage": "allow",
          "source_check": "allow",
          "subagent": "allow",
          "subagent_supervisor": "allow",
          "subagent_wait": "allow",
          "symbol_search": "allow",
          "web_search": "allow"
        },
        "bash": {
          "*": "ask",
          "basename *": "allow",
          "cat *": "allow",
          "cd *": "allow",
          "command -v *": "allow",
          "cut *": "allow",
          "df *": "allow",
          "diff *": "allow",
          "dirname *": "allow",
          "du *": "allow",
          "echo *": "allow",
          "env *": "allow",
          "file *": "allow",
          "find *": "allow",
          "git blame *": "allow",
          "git branch *": "allow",
          "git config *": "allow",
          "git diff *": "allow",
          "git grep *": "allow",
          "git log *": "allow",
          "git ls *": "allow",
          "git remote *": "allow",
          "git rev-parse *": "allow",
          "git show *": "allow",
          "git stash list *": "allow",
          "git status *": "allow",
          "git tag *": "allow",
          "grep *": "allow",
          "head *": "allow",
          "hexdump *": "allow",
          "history *": "allow",
          "ls *": "allow",
          "man *": "allow",
          "pnpm --filter *": "allow",
          "printenv *": "allow",
          "pwd *": "allow",
          "readlink *": "allow",
          "realpath *": "allow",
          "sort *": "allow",
          "stat *": "allow",
          "strings *": "allow",
          "tail *": "allow",
          "tr *": "allow",
          "tree *": "allow",
          "type *": "allow",
          "uname *": "allow",
          "uniq *": "allow",
          "wc *": "allow",
          "whatis *": "allow",
          "which *": "allow",
          "xxd *": "allow"
        }
      }
    }
