{
  "lastChangelogVersion": "0.85.1",
  "theme": "rose-pine-dawn",
  "tuiMode": "regular",
  "showHardwareCursor": false,
  "defaultProvider": "openrouter",
  "defaultModel": "openai/gpt-5.6-luna",
  "defaultThinkingLevel": "high",
  "session": {
    "titleGeneration": {
      "enabled": true,
      "language": "auto",
      "model": "openrouter/deepseek/deepseek-v4.1-flash:low",
      "retries": 1000,
      "emojis": true,
      "maxLength": 52,
      "scopeMaxLength": 12,
      "maxMessageCount": -1,
      "includeTools": true,
      "useTags": true,
      "builtinTags": true,
      "tags": []
    },
    "browser": {
      "enabled": false
    }
  },
  "subagents": {
    "agentOverrides": {
      "worker": {
        "model": "openrouter/deepseek/deepseek-v4.1-flash",
        "thinking": "max"
      },
      "reviewer": {
        "model": "openrouter/openai/gpt-5.6-luna",
        "thinking": "max"
      }
    }
  },
  "packages": [
    "npm:pi-lens",
    "npm:pi-intercom",
    "npm:pi-subagents",
    "npm:pi-mcp-adapter",
    "npm:pi-web-access",
    "npm:pi-hermes-memory",
    "npm:pi-sandbox",
    "npm:context-mode",
    "npm:pi-caveman",
    "npm:@jackice/pi-handoff",
    "npm:@narumitw/pi-plan-mode",
    "npm:@narumitw/pi-goal",
    "npm:@firstpick/pi-extension-grill-me",
    "npm:@gotgenes/pi-nocd",
    "npm:pi-loadout",
    "npm:pi-interactive-shell",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-background-tasks",
    "npm:@furbyhaxx/pi-session-naming",
    "~/github/brglng/pi-bailian",
    "~/github/brglng/pi-currency-cost",
    "~/github/brglng/pi-model-discovery",
    "~/github/brglng/pi-session-sync",
    "~/github/brglng/pi-prompt-emulated-tool-call",
    "npm:@tifan/pi-titlebar-spinner",
    "npm:@ff-labs/pi-fff",
    "npm:pi-mermaid",
    "npm:@monotykamary/pi-math",
    "npm:pi-cache-optimizer",
    "npm:@sherif-fanous/pi-theme-sync",
    "npm:@zenobius/pi-rose-pine",
    "npm:@mohndoe/pi-atlas",
    "npm:pi-open-tui"
  ],
  "hideThinkingBlock": false,
  "retry": {
    "maxRetries": 1000,
    "provider": {
      "timeoutMs": 120000
    }
  },
  "terminal": {
    "showImages": true,
    "images": "kitty"
  }
}
