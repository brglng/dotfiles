{
  "lastChangelogVersion": "0.84.2",
  "theme": "rose-pine-dawn",
  "tuiMode": "fullscreen",
  "showHardwareCursor": false,
  "defaultProvider": "openrouter",
  "defaultModel": "deepseek/deepseek-v4-flash-0731",
  "defaultThinkingLevel": "high",
  "session": {
    "titleGeneration": {
      "enabled": true,
      "language": "auto",
      "model": "openrouter/deepseek/deepseek-v4-flash-0731:medium",
      "retries": 1000,
      "emojis": true,
      "maxLength": 52,
      "scopeMaxLength": 12,
      "maxMessageCount": -1,
      "includeTools": true,
      "useTags": true,
      "builtinTags": true,
      "tags": []
    },
    "browser": {
      "enabled": false
    }
  },
  "subagents": {
    "agentOverrides": {
      "worker": {
        "model": "openrouter/deepseek/deepseek-v4-flash-0731",
        "thinking": "high"
      },
      "reviewer": {
        "model": "openrouter/openai/gpt-5.6-luna",
        "thinking": "high"
      }
    }
  },
  "packages": [
    "npm:pi-lens",
    "npm:pi-intercom",
    "npm:pi-subagents",
    "npm:pi-mcp-adapter",
    "npm:pi-web-access",
    "npm:pi-hermes-memory",
    "npm:context-mode",
    "npm:pi-caveman",
    "npm:@ssweens/pi-handoff",
    "npm:@firstpick/pi-extension-grill-me",
    "npm:@gotgenes/pi-nocd",
    "npm:pi-loadout",
    "npm:pi-interactive-shell",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-background-tasks",
    "npm:@furbyhaxx/pi-session-naming",
    "npm:@brglng/pi-portable-sessions",
    "npm:@brglng/pi-bailian",
    "npm:@brglng/pi-custom-providers",
    "npm@brglng/pi-currency-cost",
    "npm:@tifan/pi-titlebar-spinner",
    "npm:@ff-labs/pi-fff",
    "npm:@fadouse/pi-math",
    "npm:@sherif-fanous/pi-theme-sync",
    "npm:pi-zentui",
    "npm:pi-open-tui",
    "npm:@zenobius/pi-rose-pine",
    "npm:@vanillagreen/pi-session-manager",
    "npm:pi-edit-session-in-place",
    "npm:@mohndoe/pi-atlas",
    "npm:@pi-unipi/notify"
  ],
  "hideThinkingBlock": false,
  "retry": {
    "maxRetries": 1000,
    "provider": {
      "timeoutMs": 30000
    }
  },
  "terminal": {
    "showImages": true
  }
}