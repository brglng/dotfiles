{
  "lastChangelogVersion": "1.0.4",
  "theme": "rose-pine-dawn/rose-pine",
  "showHardwareCursor": false,
  "defaultProvider": "poe",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "medium",
  "defaultTools": ["+codemode", "+tool_search"],
  "session": {
    "titleGeneration": {
      "enabled": true,
      "language": "auto",
      "model": "openai-codex/gpt-6-luna:medium",
      "retries": 1000,
      "emojis": true,
      "maxLength": 52,
      "scopeMaxLength": 12,
      "maxMessageCount": -1,
      "includeTools": true,
      "useTags": true,
      "builtinTags": true,
      "tags": []
    },
    "browser": {
      "enabled": false
    }
  },
  "subagents": {
    "agentOverrides": {
      "worker": {
        "model": "poe/gpt-6.1-sol",
        "thinking": "medium"
      },
      "reviewer": {
        "model": "poe/gpt-6.1-sol",
        "thinking": "medium"
      },
      "oracle": {
        "model": "openai-codex/gpt-6-astra",
        "thinking": "medium"
      }
    }
  },
  "packages": [
    "npm:pi-lens",
    "npm:pi-background-tasks",
    "npm:pi-intercom",
    "npm:pi-subagents",
    "npm:pi-web-access",
    "npm:@narumitw/pi-usage",
    "npm:pi-hermes-memory",
    "npm:context-mode",
    "npm:@jackice/pi-handoff",
    "npm:@firstpick/pi-extension-grill-me",
    "npm:@gotgenes/pi-nocd",
    "npm:pi-interactive-shell",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@furbyhaxx/pi-session-naming",
    "~/github/brglng/pi-currency-cost",
    "~/github/brglng/pi-model-discovery",
    "~/github/brglng/pi-session-sync",
    "~/github/brglng/pi-prompt-emulated-tool-call",
    "npm:@ff-labs/pi-fff",
    "npm:@monotykamary/pi-math",
    "npm:pi-cache-optimizer",
    "npm:@zenobius/pi-rose-pine",
    "npm:@mohndoe/pi-atlas",
    "npm:pi-cc-extensions",
    "npm:@juicesharp/rpiv-todo"
  ],
  "hideThinkingBlock": false,
  "retry": {
    "maxRetries": 1000,
    "provider": {
      "timeoutMs": 120000
    }
  },
  "terminal": {
    "showImages": true,
    "images": "kitty"
  },
  "deviceId": "25649028-18e8-4d39-9c09-62a946abd041"
}
