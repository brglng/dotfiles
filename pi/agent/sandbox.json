      "**/.env",
      "**/.env.*",
      "**/*.pem",
      "**/*.key",
      "**/*.p12",
      "**/*.pfx",
      "**/secrets",
      "**/secrets/**",
      "**/.secrets",
      "**/.secrets/**",
      "~/github/brglng/pi-packages/**/.env",
      "~/github/brglng/pi-packages/**/.env.*",
      "~/github/brglng/pi-packages/**/*.pem",
      "~/github/brglng/pi-packages/**/*.key",
      "~/github/brglng/pi-packages/**/*.p12",
      "~/github/brglng/pi-packages/**/*.pfx",
      "~/github/brglng/pi-packages/**/secrets",
