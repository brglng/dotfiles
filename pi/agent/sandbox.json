{
  "enabled": true,
  "shell": {
    "readAccess": "policy"
  },
  "network": {
    "allowNetwork": false,
    "allowLocalBinding": false,
    "allowAllUnixSockets": false,
    "allowUnixSockets": [],
    "allowedDomains": ["*"],
    "deniedDomains": [
      "localhost",
      "localhost.localdomain",
      "metadata.google.internal",
      "169.254.169.254",
      "metadata.azure.com",
      "instance-data.ec2.internal",
      "*.internal",
      "*.local"
    ]
  },
  "filesystem": {
    "allowRead": ["/"],
    "denyRead": [
      "~/.ssh",
      "~/.aws",
      "~/.gnupg",
      "~/.kube",
      "~/.config/gcloud",
      "~/.config/gh/hosts.yml",
