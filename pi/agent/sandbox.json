      "~/github/brglng/pi-packages/**/.secrets/**",
      "~/github/brglng/work-sync/**/.env",
      "~/github/brglng/work-sync/**/.env.*",
      "~/github/brglng/work-sync/**/*.pem",
      "~/github/brglng/work-sync/**/*.key",
      "~/github/brglng/work-sync/**/*.p12",
      "~/github/brglng/work-sync/**/*.pfx",
      "~/github/brglng/work-sync/**/secrets",
      "~/github/brglng/work-sync/**/secrets/**",
      "~/github/brglng/work-sync/**/.secrets",
      "~/github/brglng/work-sync/**/.secrets/**"
    ],
    "allowWrite": [
      "~/github/brglng/dotfiles",
      "~/github/brglng/pi-packages",
      "~/github/brglng/work-sync"
